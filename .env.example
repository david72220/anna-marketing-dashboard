# Base de données (SQLite pour dev, PostgreSQL pour prod)
DATABASE_URL="file:./dev.db"

# Authentification NextAuth
NEXTAUTH_SECRET="generer-avec-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="votre-email@exemple.com"
ADMIN_PASSWORD="votre-mot-de-passe-securise"

# Notion API
NOTION_API_KEY="votre_notion_api_key"
NOTION_ANALYSES_DB_ID="votre-analyses-db-id"
NOTION_VEILLE_DB_ID="votre-veille-db-id"
NOTION_BACKLOG_DB_ID="votre-backlog-db-id"

# Notion — veille concurrents (Module D)
NOTION_CONCURRENTS_COMPTES_DB_ID="votre-comptes-concurrents-db-id"
NOTION_CONCURRENTS_POSTS_DB_ID="votre-posts-concurrents-db-id"

# YouTube Data API
YOUTUBE_API_KEY="votre_youtube_api_key"

# YouTube Channel IDs
ANNA_YOUTUBE_CHANNEL_ID="votre-youtube-channel-id"
DAVID_YOUTUBE_CHANNEL_ID=""

# PhantomBuster (Instagram)
PHANTOMBUSTER_API_KEY="votre_phantombuster_api_key"
PHANTOMBUSTER_INSTAGRAM_AGENT_ID="votre_instagram_agent_id"

# Apify (TikTok)
APIFY_API_TOKEN="votre_apify_api_token"
APIFY_TIKTOK_ACTOR_ID="votre_tiktok_actor_id"

# Instagram & TikTok usernames
ANNA_INSTAGRAM_USER="votre_instagram_username"
ANNA_TIKTOK_USER="votre_tiktok_username"

# Facebook (pas encore intégré)
FACEBOOK_PAGE_ANNA="votre_facebook_page"

# Cron secret pour la collecte automatique
CRON_SECRET="votre-secret-cron"

# N8N Webhooks
N8N_WEBHOOK_ANALYSES="https://votre-instance-n8n.com/webhook/analyses"
N8N_WEBHOOK_VEILLE="https://votre-instance-n8n.com/webhook/veille"
N8N_WEBHOOK_BACKLOG="https://votre-instance-n8n.com/webhook/backlog"
# Pas de webhook pour le Module D : N8N n'a pas su protéger l'endpoint
# (authentication headerAuth ignorée). Collecte par cron hebdomadaire uniquement.
# Basic auth des webhooks N8N anna-* (appliqué par Traefik, pas par N8N)
# Format "utilisateur:motdepasse", identique au middleware anna-webhook-auth
N8N_WEBHOOK_BASIC_AUTH="anna:un-mot-de-passe-genere"
